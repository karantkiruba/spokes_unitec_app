{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-08-03 19:05:13.395932",
 "css": ".print-format {\n\t\tmargin-top: 3mm;\n\t\tmargin-left: 0.3mm;\n\t\tmargin-right: 3.3mm;\n\t\tmargin-bottom: 1mm;\n\t\n\t}\n\t\n\n\t\n\t.blank-row td {\n    border-top: none !important;\n    border-bottom: none !important;\n    height: 18px;\n}\n\n/* Keep left and right borders */\n.blank-row td:first-child {\n    border-left: 1px solid #000 !important;\n}\n\n.blank-row td {\n    border-right: 1px solid #000 !important;\n}\n\n/* Bottom border ONLY on the last blank row */\n.blank-row:last-child td {\n    border-bottom: 1px solid #000 !important;\n}",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Transfer Out",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n    @page {\r\n        size: A4;\r\n        margin: 0;\r\n    }\r\n\r\n    * {\r\n        box-sizing: border-box;\r\n    }\r\n\r\n    html,\r\n    body {\r\n        margin: 0;\r\n        padding: 0;\r\n        font-family: Arial, Helvetica, sans-serif;\r\n        color: #000;\r\n        font-size: 10px;\r\n    }\r\n\r\n    .print-page {\r\n        width: 210mm;\r\n        /*min-height: 297mm;*/\r\n        padding: 10mm 10mm 5mm 10mm;\r\n    }\r\n\r\n    .gate-pass {\r\n        width: 100%;\r\n      \r\n        border: 1px solid #999;\r\n        border-collapse: collapse;\r\n        table-layout: fixed;\r\n    }\r\n\r\n    .gate-pass > tbody > tr > td {\r\n        border: 1px solid #999;\r\n        padding: 0;\r\n        vertical-align: top;\r\n    }\r\n\r\n    /* =====================================================\r\n       HEADER\r\n    ===================================================== */\r\n\r\n    .header-cell {\r\n        height: 120px;\r\n        position: relative;\r\n        padding: 30px 10px 5px 133px !important;\r\n    }\r\n\r\n    .logo {\r\n        position: absolute;\r\n        left: 25px;\r\n        top: 40px;\r\n        width: 75px;\r\n        height: auto;\r\n    }\r\n\r\n    .company-name {\r\n        font-size: 14px;\r\n        font-weight: bold;\r\n        line-height: 22px;\r\n    }\r\n\r\n    .company-address {\r\n        font-size: 12px;\r\n        line-height: 15px;\r\n    }\r\n\r\n    .company-address div {\r\n        margin: 0;\r\n        padding: 0;\r\n    }\r\n\r\n    .document-title {\r\n        position: absolute;\r\n        right: 2px;\r\n        bottom: 1px;\r\n        font-size: 30px;\r\n        font-weight: normal;\r\n        white-space: nowrap;\r\n    }\r\n\r\n    /* =====================================================\r\n       DETAILS\r\n    ===================================================== */\r\n\r\n    .details-cell {\r\n        height: 51px;\r\n        padding: 0 !important;\r\n    }\r\n\r\n    .details-table {\r\n        width: 100%;\r\n        height: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .details-table td {\r\n        border: none !important;\r\n        padding: 3px 7px;\r\n        font-size: 11px;\r\n        line-height: 14px;\r\n        vertical-align: top;\r\n    }\r\n\r\n    .details-table .label {\r\n        width: 41%;\r\n    }\r\n\r\n    .details-table .colon {\r\n        width: 4%;\r\n        text-align: center;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .details-table .value {\r\n        font-weight: bold;\r\n        width: 55%;\r\n    }\r\n\r\n    .details-right {\r\n        border-left: 1px solid #999 !important;\r\n    }\r\n\r\n    /* =====================================================\r\n       SECTION TITLE\r\n    ===================================================== */\r\n\r\n    .section-title {\r\n        background: #eeeeee;\r\n        height: 19px;\r\n        padding: 3px 7px !important;\r\n        font-size: 11px;\r\n        font-weight: bold;\r\n        vertical-align: middle !important;\r\n    }\r\n\r\n    /* =====================================================\r\n       DELIVER TO\r\n    ===================================================== */\r\n\r\n    .deliver-cell {\r\n        height: auto;\r\n        padding: 9px 7px !important;\r\n        font-size: 11px;\r\n        line-height: 16px;\r\n    }\r\n\r\n    .deliver-name {\r\n        font-weight: normal;\r\n        margin-bottom: 2px;\r\n    }\r\n\r\n    /* =====================================================\r\n       ITEM TABLE\r\n    ===================================================== */\r\n\r\n   .items-cell {\r\n    padding: 0 !important;\r\n    margin: 0 !important;\r\n    border: 1px solid black !important;\r\n}\r\n\r\n.items-cell .item-table {\r\n    width: 100% !important;\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    border: 0 !important;\r\n    border-collapse: collapse !important;\r\n    border-spacing: 0 !important;\r\n}\r\n\r\n.items-cell {\r\n    padding: 0 !important;\r\n    margin: 0 !important;\r\n    border: 1px solid #000 !important;\r\n    vertical-align: top !important;\r\n}\r\n\r\n.items-cell .item-table {\r\n    width: 100% !important;\r\n    height: 100% !important;\r\n    margin: -1px !important;\r\n    padding: 0 !important;\r\n    border: 1px solid #000 !important;\r\n    border-collapse: collapse !important;\r\n    border-spacing: 0 !important;\r\n}\r\n\r\n.items-cell .item-table th,\r\n.items-cell .item-table td {\r\n    border: 1px solid #000 !important;\r\n}\r\n\r\n.items-cell .item-table tr:first-child th {\r\n    border-top: 0 !important;\r\n}\r\n\r\n.items-cell .item-table tr:last-child td {\r\n    border-bottom: 0 !important;\r\n}\r\n\r\n.items-cell .item-table th:first-child,\r\n.items-cell .item-table td:first-child {\r\n    border-left: 0 !important;\r\n}\r\n\r\n.items-cell .item-table th:last-child,\r\n.items-cell .item-table td:last-child {\r\n    border-right: 0 !important;\r\n}\r\n\r\n    .item-table th {\r\n        background: #eeeeee;\r\n        border: 1px solid #999;\r\n        padding: 5px 6px;\r\n        height: 42px;\r\n        font-size: 11px;\r\n        font-weight: bold;\r\n        text-align: left;\r\n        vertical-align: middle;\r\n    }\r\n\r\n    .item-table td {\r\n        border: 1px solid #999;\r\n        padding: 5px 6px;\r\n        font-size: 11px;\r\n        line-height: 14px;\r\n        vertical-align: top;\r\n    }\r\n\r\n    .item-table .sl {\r\n        width: 6%;\r\n        text-align: center;\r\n    }\r\n\r\n    .item-table .description {\r\n        width: 49%;\r\n    }\r\n\r\n    .item-table .location {\r\n        width: 15%;\r\n    }\r\n\r\n    .item-table .moq {\r\n        width: 11%;\r\n        text-align: right;\r\n    }\r\n\r\n    .item-table .rate {\r\n        width: 10%;\r\n        text-align: right;\r\n    }\r\n\r\n    .item-table .amount {\r\n        width: 11%;\r\n        text-align: right;\r\n    }\r\n\r\n    .item-code {\r\n        font-weight: bold;\r\n    }\r\n\r\n    .item-row td {\r\n        height: 50px;\r\n    }\r\n\r\n    /* =====================================================\r\n       LOWER SECTION\r\n    ===================================================== */\r\n\r\n    .bottom-cell {\r\n        padding: 0 !important;\r\n        height: 190px;\r\n    }\r\n\r\n    .bottom-table {\r\n        width: 100%;\r\n        height: 100%;\r\n        border-collapse: collapse;\r\n        table-layout: fixed;\r\n    }\r\n\r\n    .bottom-table > tbody > tr > td {\r\n        vertical-align: top;\r\n    }\r\n\r\n    /* LEFT NOTES */\r\n\r\n    .notes-section {\r\n        width: 56%;\r\n        padding: 10px 8px !important;\r\n        border-right: 1px solid #999;\r\n        font-size: 11px;\r\n        line-height: 15px;\r\n    }\r\n\r\n    .notes-title {\r\n        margin-bottom: 3px;\r\n    }\r\n\r\n    .notes-content {\r\n        line-height: 15px;\r\n    }\r\n\r\n    .terms-title {\r\n        margin-top: 23px;\r\n        margin-bottom: 3px;\r\n    }\r\n\r\n    .terms-content {\r\n        line-height: 15px;\r\n    }\r\n\r\n    /* RIGHT TOTAL + SIGNATURE */\r\n\r\n    .right-section {\r\n        width: 44%;\r\n        padding: 0 !important;\r\n    }\r\n\r\n    .total-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .total-table td {\r\n        border: none !important;\r\n        padding: 3px 8px;\r\n        font-size: 11px;\r\n        line-height: 15px;\r\n    }\r\n\r\n    .total-label {\r\n        text-align: right;\r\n    }\r\n\r\n    .total-value {\r\n        width: 30%;\r\n        text-align: right;\r\n    }\r\n\r\n    .tax-value {\r\n        color: red;\r\n    }\r\n\r\n    .grand-total td {\r\n        font-weight: bold;\r\n        border-top: 1px solid #999 !important;\r\n        padding-top: 4px;\r\n        padding-bottom: 4px;\r\n    }\r\n\r\n    .signature-section {\r\n        height: 122px;\r\n        border-top: 1px solid #999;\r\n        position: relative;\r\n        text-align: center;\r\n        padding-top: 8px;\r\n        font-size: 11px;\r\n    }\r\n\r\n    .signature-image {\r\n        display: block;\r\n        width: 110px;\r\n        max-height: 50px;\r\n        object-fit: contain;\r\n        margin: 8px auto 3px auto;\r\n    }\r\n\r\n    .authorized {\r\n        position: absolute;\r\n        bottom: 8px;\r\n        left: 0;\r\n        right: 0;\r\n        text-align: center;\r\n    }\r\n    \r\n    \r\n    .blank-row td {\r\n    border-top: none !important;\r\n    border-bottom: none !important;\r\n    height: 23px !important;\r\n    padding: 0 !important;\r\n}\r\n\r\n    /* Keep left and right borders */\r\n    .blank-row td:first-child {\r\n        border-left: 1px solid #000 !important;\r\n    }\r\n    \r\n    \r\n    /* Bottom border ONLY on the last blank row */\r\n    .blank-row:last-child td {\r\n        border-bottom: 1px solid #000 !important;\r\n    }\r\n\r\n\r\n    /* =====================================================\r\n       PRINT\r\n    ===================================================== */\r\n\r\n    @media print {\r\n\r\n        .gate-pass {\r\n            page-break-inside: avoid;\r\n        }\r\n\r\n        .item-table {\r\n            page-break-inside: avoid;\r\n        }\r\n    }\r\n</style>\r\n\r\n\r\n{# ========================================================\r\n   COMPANY ADDRESS\r\n======================================================== #}\r\n\r\n{% if doc.bill_from_address %}\r\n    {% set company_address = frappe.get_doc(\"Address\", doc.bill_from_address) %}\r\n{% endif %}\r\n\r\n\r\n{# ========================================================\r\n   SHIPPING ADDRESS / PLACE OF SUPPLY\r\n======================================================== #}\r\n\r\n{% if doc.shipping_address_name %}\r\n\r\n    {% set shipping_address = frappe.get_doc(\r\n        \"Address\",\r\n        doc.shipping_address_name\r\n    ) %}\r\n\r\n{% endif %}\r\n\r\n\r\n<div class=\"print-page\">\r\n\r\n<div style=\"text-align:right;font-weight:bold;margin-bottom:10px\" >\r\n                (Original For Recipient)\r\n            </div> \r\n<table class=\"gate-pass\">\r\n\r\n    <!-- ==================================================\r\n         HEADER\r\n    ================================================== -->\r\n\r\n    <tr>\r\n        <td colspan=\"2\" class=\"header-cell\">\r\n\r\n            {% if company_address and company_address.company_logo %}\r\n                <img src=\"{{ company_address.company_logo }}\"\r\n                     class=\"logo\">\r\n            {% else %}\r\n                <img src=\"/files/FinalLogo.png\"\r\n                     class=\"logo\">\r\n            {% endif %}\r\n\r\n\r\n            <div class=\"company-name\" style =\"margin-left:100px;margin-top:10px\">\r\n                {{ doc.company or \"Unitec Tool Management\" }}\r\n            </div>\r\n\r\n\r\n           \r\n            \r\n                {% if doc.company_address %}\r\n            \r\n                    {% set company = frappe.get_doc(\"Address\", doc.company_address) %}\r\n            \r\n                    <div class=\"company-address\" style =\"margin-left:100px;\">\r\n            \r\n                        <div class=\"company-name\">\r\n                            {{ company.company or \"\" }}\r\n                        </div>\r\n            \r\n                        <div class=\"company-address\">\r\n                            {{ company.address_line1 or \"\" }} <br>\r\n                            <!--{{ company.address_line2 or \"\" }} <br>-->\r\n                            {{ company.city or \"\" }},\r\n                            {{ company.state or \"\" }}-\r\n                            {{ company.pincode or \"\" }}<br>\r\n            \r\n                            India<br>\r\n            \r\n                            GSTIN:{{ company.gstin or \"\" }}<br>\r\n            \r\n                            {{ company.email_id or \"\" }}\r\n                        </div>\r\n            \r\n                    </div>\r\n            \r\n                {% endif %}\r\n            \r\n\r\n            \r\n\r\n            <div class=\"document-title\">\r\n                Returnable Gate Pass\r\n            </div>\r\n\r\n        </td>\r\n    </tr>\r\n\r\n    <tr>\r\n\r\n        <td width=\"50%\" class=\"details-cell\">\r\n\r\n            <table class=\"details-table\">\r\n\r\n                <tr>\r\n                    <td style=\"margin-bottom:30px\">\r\n                        DC Number\r\n                    </td>\r\n\r\n                    <td class=\"colon\">:</td>\r\n\r\n                    <td class=\"value\">\r\n                        {{ doc.name }}\r\n                    </td>\r\n                </tr>\r\n\r\n                <tr>\r\n                    <td style=\"margin-bottom:30px\">\r\n                        DC Date\r\n                    </td>\r\n\r\n                    <td class=\"colon\">:</td>\r\n\r\n                    <td class=\"value\">\r\n                        {% if doc.posting_date %}\r\n                            {{ doc.get_formatted(\"posting_date\") }}\r\n                        {% elif doc.transaction_date %}\r\n                            {{ doc.get_formatted(\"transaction_date\") }}\r\n                        {% endif %}\r\n                    </td>\r\n                </tr>\r\n\r\n            </table>\r\n\r\n        </td>\r\n\r\n\r\n        <!-- RIGHT -->\r\n        <td width=\"50%\" class=\"details-cell details-right\">\r\n\r\n            <table class=\"details-table\">\r\n\r\n                <tr>\r\n                    <td style=\"margin-bottom:30px\">\r\n                        Place Of Supply\r\n                    </td>\r\n\r\n                    <td class=\"colon\">:</td>\r\n\r\n                    <td class=\"value\">\r\n                        \r\n                        {% set supplier = frappe.get_doc(\"Address\", supplier_address) %}\r\n\r\n                        {% if supplier %}\r\n\r\n                            {{ supplier.gst_state or supplier.state or \"\" }}\r\n\r\n                            {% if supplier.gst_state_number %}\r\n                                ({{ supplier.gst_state_number }})\r\n                            {% endif %}\r\n\r\n                        {% endif %}\r\n\r\n                    </td>\r\n                </tr>\r\n\r\n\r\n                <tr>\r\n                    <td style=\"margin-bottom:30px\">\r\n                        Challan Type\r\n                    </td>\r\n\r\n                    <td class=\"colon\">:</td>\r\n\r\n                    <td class=\"value\"\r\n                        style=\"position:relative; top:1px;\">\r\n\r\n                        {{ doc.challan_type or \"Job Work\" }}\r\n\r\n                    </td>\r\n                </tr>\r\n\r\n            </table>\r\n\r\n        </td>\r\n\r\n    </tr>\r\n\r\n\r\n    <!-- ==================================================\r\n         DELIVER TO TITLE\r\n    ================================================== -->\r\n\r\n    <tr>\r\n        <td colspan=\"2\" class=\"section-title\">\r\n            Deliver To\r\n        </td>\r\n    </tr>\r\n\r\n\r\n    <!-- ==================================================\r\n         DELIVER TO ADDRESS\r\n    ================================================== -->\r\n\r\n    <tr>\r\n        <td colspan=\"2\" class=\"deliver-cell\">\r\n\r\n            <div class=\"deliver-name\">\r\n               <b>{{ doc.customer_address or \"\" }}</b> \r\n            </div>\r\n\r\n\r\n            {% if doc.customer_address %}\r\n            \r\n            {% set suppliers = frappe.get_doc(\"Address\", doc.customer_address) %}\r\n            \r\n                    <div class=\"company-address\">\r\n            \r\n                        <div class=\"company-name\">\r\n                            {{ suppliers.company or \"\" }}\r\n                        </div>\r\n            \r\n                        <div class=\"company-address\">\r\n                            {{ suppliers.address_line1 or \"\" }} \r\n                            {{ suppliers.address_line2 or \"\" }} \r\n                            {{ suppliers.city or \"\" }}<br>\r\n                            {{ suppliers.state or \"\" }}\r\n                            <br>\r\n            \r\n                            India {{ suppliers.pincode or \"\" }}<br>\r\n            \r\n                        </div>\r\n            \r\n                    </div>\r\n            {% endif %}\r\n            \r\n\r\n        </td>\r\n    </tr>\r\n\r\n\r\n    <!-- ==================================================\r\n         ITEM TABLE\r\n    ================================================== -->\r\n\r\n    <tr>\r\n\r\n        <td colspan=\"2\"\r\n    style=\"\r\n        padding:0 !important;\r\n        margin:0 !important;\r\n        vertical-align:top;\r\n    \">\r\n\r\n    <table class=\"item-table\"\r\n        style=\"\r\n            width:100% !important;\r\n            margin:-1px !important;\r\n            padding:0 !important;\r\n            border-collapse:collapse !important;\r\n            border-spacing:0 !important;\r\n        \">\r\n\r\n        <thead>\r\n            <tr>\r\n\r\n                <th>Sl.<br>No.</th>\r\n\r\n                <th style=\"text-align:center;\">\r\n                    SKU &amp; Description of Goods\r\n                </th>\r\n\r\n                <th style=\"text-align:center;\">\r\n                    Location\r\n                </th>\r\n\r\n                <th style=\"text-align:center;\">\r\n                    MOQ\r\n                </th>\r\n\r\n                <th style=\"text-align:center;\">\r\n                    Rate\r\n                </th>\r\n\r\n                <th style=\"text-align:center;\">\r\n                    Amount\r\n                </th>\r\n\r\n            </tr>\r\n        </thead>\r\n\r\n        <tbody>\r\n\r\n            {% for row in doc.items %}\r\n\r\n            <tr>\r\n\r\n                <td style=\"text-align:center;\">\r\n                    {{ row.idx }}\r\n                </td>\r\n\r\n                <td>\r\n                    <span>{{ row.item_code or \"\" }}</span>\r\n\r\n                    {% if row.description %}\r\n                        <br>{{ row.description }}\r\n                    {% endif %}\r\n                </td>\r\n\r\n                <td style=\"text-align:center;\">\r\n                    {{ row.s_warehouse or \"\" }}\r\n                </td>\r\n\r\n                <td style=\"text-align:center;\">\r\n                    {{ \"%.2f\"|format(row.qty or 0) }}\r\n\r\n                    {% if row.uom %}\r\n                        <br>{{ row.uom }}\r\n                    {% endif %}\r\n                </td>\r\n\r\n                <td style=\"text-align:right;\">\r\n                    {{ \"{:,.2f}\".format(row.rate or 0) }}\r\n                </td>\r\n\r\n                <td style=\"text-align:right;\">\r\n                    {{ \"{:,.2f}\".format(row.amount or 0) }}\r\n                </td>\r\n\r\n            </tr>\r\n\r\n            {% endfor %}\r\n            \r\n            {% set blank_rows = 15 - (doc.items|length) %}\r\n\r\n            {% if blank_rows > 0 %}\r\n        \r\n                {% for i in range(blank_rows) %}\r\n        \r\n                <tr class=\"blank-row\">\r\n        \r\n                    <td></td>\r\n                    <td></td>\r\n                    <td></td>\r\n                    <td></td>\r\n                    <td></td>\r\n                    <td></td>\r\n        \r\n                </tr>\r\n        \r\n                {% endfor %}\r\n        \r\n            {% endif %}\r\n\r\n        </tbody>\r\n\r\n    </table>\r\n\r\n</td>\r\n\r\n    </tr>\r\n    \r\n\r\n\r\n    <!-- ==================================================\r\n         NOTES + TOTAL + SIGNATURE\r\n    ================================================== -->\r\n\r\n    <tr>\r\n        \r\n\r\n        <td colspan=\"2\"\r\n    style=\"\r\n        padding:0 !important;\r\n        margin:0 !important;\r\n        border:1px solid gray !important;\r\n        vertical-align:top;\r\n    \">\r\n\r\n    <table\r\n        style=\"\r\n            width:100% !important;\r\n            margin:-1px !important;\r\n            padding:0 !important;\r\n            border:0 !important;\r\n            border-collapse:collapse !important;\r\n            border-spacing:0 !important;\r\n        \">\r\n\r\n        <tr>\r\n\r\n            <!-- LEFT NOTES -->\r\n           \r\n            <td style=\"\r\n                width:60%;\r\n                padding:6px;\r\n                vertical-align:top;\r\n                border:1px solid gray;\r\n                border-left:0 !important;\r\n                border-top:0 !important;\r\n                border-bottom:0 !important;\r\n            \">\r\n                \r\n                 <div style=\"margin-bottom:20px;line-height:14px;\">\r\n                     Total Items\r\n                    {{ \"%.2f\"|format(doc.total_qty or (doc.items|sum(attribute='qty')) or 0) }}\r\n                     \r\n                 </div>\r\n    \r\n               \r\n                <b>Notes</b>\r\n\r\n                <div style=\"margin-top:5px;line-height:14px;\">\r\n                    PLEASE MENTION TOOL CODE ALONG WITH\r\n                    DESCRIPTION IN ALL<br>\r\n                    INVOICES OTHERWISE YOUR INVOICE NOT\r\n                    ACCEPTABLE\r\n                </div>\r\n\r\n                <br>\r\n\r\n                <b>Terms &amp; Conditions</b>\r\n\r\n                <div style=\"margin-top:5px;line-height:14px;\">\r\n                    KINDLY RETURN THE ITEMS MENTIONED ABOVE\r\n                    WITHIN 15 DAYS,\r\n                </div>\r\n\r\n            </td>\r\n\r\n\r\n            <!-- RIGHT TOTAL -->\r\n            <td style=\"\r\n                width:40%;\r\n                padding:0 !important;\r\n                margin:0 !important;\r\n                vertical-align:top;\r\n                border:0 !important;\r\n            \">\r\n\r\n                <table\r\n                    style=\"\r\n                        width:100% !important;\r\n                        margin:0px !important;\r\n                        padding:0 !important;\r\n                        border:0 !important;\r\n                        border-collapse:collapse !important;\r\n                        border-spacing:0 !important;\r\n                    \">\r\n\r\n                    <tr>\r\n\r\n                        <td style=\"\r\n                            width:55%;\r\n                            padding:4px;\r\n                            text-align:right;\r\n                            border-left:0 !important;\r\n                            border-top:0 !important;\r\n                        \">\r\n                            Sub Total\r\n                        </td>\r\n\r\n                        <td style=\"\r\n                            width:45%;\r\n                            padding:4px;\r\n                            text-align:right;\r\n                            border-right:0 !important;\r\n                            border-top:0 !important;\r\n                            border-bottom:0 !important;\r\n                            white-space:nowrap;\r\n                        \">\r\n                            \r\n                                {{ \"{:,.2f}\".format(doc.base_grand_total or 0) }}\r\n                            \r\n                        </td>\r\n\r\n                    </tr>\r\n\r\n\r\n                    {% for tax in doc.taxes %}\r\n                    \r\n                        {% set row = doc.items[0] %}\r\n\r\n                    <tr>\r\n\r\n                        <td style=\"\r\n                            padding:5px;\r\n                            text-align:right;\r\n                            border:1px solid gray;\r\n